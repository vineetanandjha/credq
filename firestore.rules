rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /landingLeads/{leadId} {
      allow create: if
        request.resource.data.firstName is string &&
        request.resource.data.firstName.size() > 0 &&
        request.resource.data.mobile is string &&
        request.resource.data.mobile.size() > 0 &&
        request.resource.data.pagePath is string &&
        request.resource.data.pageTitle is string &&
        request.resource.data.source == 'landing_two_step' &&
        request.resource.data.consent == true &&
        request.resource.data.capturedAt is string;

      allow read, update, delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
